jumlah = 0
total = 0
total_jarak = 0
terjauh = 0

while True:
    jarak = float(input("Masukkan jarak (0 untuk selesai): "))

    if jarak == 0:
        break
    elif jarak < 0:
        print("Jarak tidak valid!")
        continue

    jumlah += 1
    total_jarak += jarak

    if jarak > terjauh:
        terjauh = jarak

    if jarak <= 5:
        tarif = 3000
    elif jarak <= 15:
        tarif = 3000 + (jarak - 5) * 1000
    else:
        tarif = 13000 + (jarak - 15) * 500

    if jumlah % 5 == 0:
        tarif = tarif * 0.5
        print("Diskon 50%")

    total += tarif
    print("Tarif: Rp", int(tarif))

print("\nJumlah penumpang:", jumlah)
print("Total pendapatan: Rp", int(total))
print("Jarak terjauh:", terjauh, "km")

if jumlah > 0:
    print("Rata-rata jarak:", round(total_jarak / jumlah, 2), "km")
else:
    print("Rata-rata jarak: 0 km")